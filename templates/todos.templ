package templates

import db "github.com/antoni-ostrowski/habit-tracker/internal/db/sqlc"
import "fmt"

// Page is FULL page. Only the GET / handler uses it. username is "" when
// signed out, and then the page links to sign-in instead of the todo form.
templ Page(todos []db.Todo, username string) {
	@Layout("Todos") {
		<main class="mx-auto max-w-xl px-4 py-10">
			<h1 class="text-2xl font-semibold tracking-tight">todos</h1>
			if username != "" {
				<div class="mt-2 flex items-center justify-between text-sm text-neutral-500">
					<span>signed in as <span class="font-medium text-neutral-700">{ username }</span></span>
					<form method="post" action="/signout">
						<button type="submit" class="underline hover:text-neutral-800">sign out</button>
					</form>
				</div>
				<form hx-post="/todos" hx-target="#todo-list" hx-swap="innerHTML" hx-on::after-request="if(event.detail.successful) this.reset()" class="mt-4 flex gap-2">
					<input name="title" placeholder="What needs to be done?" required autocomplete="off" class="flex-1 rounded-md border border-neutral-300 bg-white px-3 py-2 text-sm focus:border-neutral-500 focus:outline-none"/>
					<button type="submit" class="rounded-md bg-neutral-900 px-4 py-2 text-sm font-medium text-white hover:bg-neutral-700">Add</button>
				</form>
			} else {
				<p class="mt-2 text-sm text-neutral-500"><a href="/signin" class="underline">sign in</a> or <a href="/signup" class="underline">sign up</a> to manage todos</p>
			}
			@List(todos)
			<p class="mt-6 text-xs text-neutral-400">Full page via GET /. Fragments via POST/DELETE /todos.</p>
		</main>
	}
}

// List is FRAGMENT. Mutation handlers return this, htmx swaps #todo-list.
templ List(todos []db.Todo) {
	<ul id="todo-list" class="mt-4 divide-y divide-neutral-200 rounded-md border border-neutral-200 bg-white">
		for _, t := range todos {
			@Item(t)
		}
		if len(todos) == 0 {
			<li class="px-4 py-3 text-sm text-neutral-400">no todos yet — add one above</li>
		}
	</ul>
}

templ Item(t db.Todo) {
	<li class="flex items-center gap-2 px-3 py-1.5">
		<button
			hx-post={ fmt.Sprintf("/todos/%d/toggle", t.ID) }
			hx-target="#todo-list"
			hx-swap="innerHTML"
			class={ "flex-1 rounded px-2 py-1 text-left text-sm hover:bg-neutral-100", templ.KV("text-neutral-400 line-through", t.Done) }
		>
			if t.Done {
				✓ { t.Title }
			} else {
				○ { t.Title }
			}
		</button>
		<button
			hx-delete={ fmt.Sprintf("/todos/%d", t.ID) }
			hx-target="#todo-list"
			hx-swap="innerHTML"
			class="rounded px-2 py-1 text-sm text-red-600 hover:bg-red-50"
		>
			delete
		</button>
	</li>
}
