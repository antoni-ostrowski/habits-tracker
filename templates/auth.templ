package templates

// Signup is FULL page. POST /signup re-renders it with errMsg on failure.
templ Signup(errMsg string) {
	@Layout("sign up", "") {
		<main class="mx-auto max-w-md px-4 py-10">
			<h1 class="text-lg font-bold">sign up</h1>
			if errMsg != "" {
				<p role="alert" class="mt-4 border-2 border-red-500 px-3 py-1.5 font-mono text-sm text-red-400">{ errMsg }</p>
			}
			<form method="post" action="/signup" class="mt-4 flex flex-col gap-2">
				<input name="username" placeholder="username" required autocomplete="username" class="border-2 border-neutral-800 bg-transparent px-3 py-1.5 text-sm outline-none placeholder:text-neutral-600 focus:border-neutral-100"/>
				<input name="password" type="password" placeholder="password (min 8)" required autocomplete="new-password" class="border-2 border-neutral-800 bg-transparent px-3 py-1.5 text-sm outline-none placeholder:text-neutral-600 focus:border-neutral-100"/>
				<button type="submit" class="bg-neutral-100 px-3 py-1.5 text-sm font-bold text-black hover:bg-[#00B4D8]">sign up</button>
			</form>
			<p class="mt-4 font-mono text-sm text-neutral-500">have account? <a href="/signin" class="font-bold text-neutral-100 underline">sign in</a></p>
		</main>
	}
}

// Signin is FULL page. POST /signin re-renders it with errMsg on failure.
templ Signin(errMsg string) {
	@Layout("sign in", "") {
		<main class="mx-auto max-w-md px-4 py-10">
			<h1 class="text-lg font-bold">sign in</h1>
			if errMsg != "" {
				<p role="alert" class="mt-4 border-2 border-red-500 px-3 py-1.5 font-mono text-sm text-red-400">{ errMsg }</p>
			}
			<form method="post" action="/signin" class="mt-4 flex flex-col gap-2">
				<input name="username" placeholder="username" required autocomplete="username" class="border-2 border-neutral-800 bg-transparent px-3 py-1.5 text-sm outline-none placeholder:text-neutral-600 focus:border-neutral-100"/>
				<input name="password" type="password" placeholder="password" required autocomplete="current-password" class="border-2 border-neutral-800 bg-transparent px-3 py-1.5 text-sm outline-none placeholder:text-neutral-600 focus:border-neutral-100"/>
				<button type="submit" class="bg-neutral-100 px-3 py-1.5 text-sm font-bold text-black hover:bg-[#00B4D8]">sign in</button>
			</form>
			<p class="mt-4 font-mono text-sm text-neutral-500">no account? <a href="/signup" class="font-bold text-neutral-100 underline">sign up</a></p>
		</main>
	}
}
